{
  "name": "convodesk",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI inbox + mini-CRM (MEAN + TypeScript)",
  "license": "MIT",
  "type": "module",
  "author": "Brajesh Mohanty",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "shared",
    "server",
    "widget",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run build -w shared",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w widget && npm run build -w client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run start -w client",
    "dev:widget": "npm run dev -w widget",
    "lint": "eslint . && npm run lint -w client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
