# ConvoDesk — environment variables
# Copy to `.env` for local development. NEVER commit `.env`.
# In production these are set in the Render (API) and Vercel (client) dashboards.
# Each variable is validated at boot by server/src/config/env.ts — a missing one stops the server with a clear error.

# ── Server basics ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/convodesk
# Production: MongoDB Atlas M0 connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/convodesk

# ── Browser access ──────────────────────────────────────────────
# Comma-separated origins allowed to call the API with credentials (the Angular app).
CORS_ORIGINS=http://localhost:4200

# Public URL of the Angular app (used to build invite links).
APP_URL=http://localhost:4200

# ── Auth ────────────────────────────────────────────────────────
# REQUIRED. At least 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime (seconds). Default 900 = 15 min.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# bcrypt cost. 10 is right for Render's free CPU; tests use 4.
BCRYPT_ROUNDS=10
# lax (default, with the Vercel /api proxy) | strict | none (only if calling Render cross-site; needs COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true

# More variables (LLM keys, WhatsApp credentials) are added in later phases.
